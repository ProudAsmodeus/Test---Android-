<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rom.adguardcontrol">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <package android:name="com.adguard.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_adguard_tile"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".AdGuardConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AdGuardFreeTileService"
            android:label="@string/tile_free_label"
            android:icon="@drawable/ic_adguard_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AdGuardPaidTileService"
            android:label="@string/tile_paid_label"
            android:icon="@drawable/ic_adguard_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
